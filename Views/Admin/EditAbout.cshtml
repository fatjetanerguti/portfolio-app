@model PortfolioApp.Models.AboutMe
@{
    ViewData["Title"] = "Edito Profilin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edito Profilin</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #0a0a0f;
            --bg2: #111118;
            --card: #16161f;
            --border: #ffffff12;
            --accent: #7c6aff;
            --accent2: #ff6a9b;
            --text: #f0f0f5;
            --muted: #8888aa;
            --radius: 14px;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Space Grotesk', sans-serif;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 240px;
            height: 100vh;
            background: var(--bg2);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 1.5rem;
            z-index: 100;
            transition: transform 0.3s;
        }

        .sidebar-logo {
            font-family: 'Syne', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-menu {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

            .sidebar-item:hover, .sidebar-item.active {
                background: rgba(124,106,255,0.1);
                color: var(--text);
            }

            .sidebar-item.active {
                color: var(--accent);
            }

            .sidebar-item i {
                width: 18px;
                text-align: center;
            }

        .sidebar-bottom {
            border-top: 1px solid var(--border);
            padding-top: 1rem;
        }

        .menu-toggle {
            display: none;
            position: fixed;
            top: 1rem;
            left: 1rem;
            z-index: 200;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.5rem 0.7rem;
            cursor: pointer;
            color: var(--text);
        }

        .main {
            margin-left: 240px;
            padding: 2rem;
        }

        .page-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .back-btn {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

            .back-btn:hover {
                color: var(--accent);
            }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
        }

        .alert-success {
            background: rgba(74,222,128,0.1);
            border: 1px solid rgba(74,222,128,0.3);
            color: #4ade80;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
        }

        .form-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 2rem;
            max-width: 700px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }

        .form-group {
            margin-bottom: 0;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

        label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        input[type="text"], input[type="email"], input[type="url"], textarea {
            width: 100%;
            background: #0a0a0f;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.8rem 1rem;
            color: var(--text);
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s;
        }

            input:focus, textarea:focus {
                border-color: var(--accent);
            }

        textarea {
            resize: vertical;
            min-height: 120px;
        }

        .profile-preview {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 1rem;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent);
        }

        .profile-avatar-placeholder {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: 800;
            color: white;
            flex-shrink: 0;
        }

        .upload-area {
            border: 2px dashed var(--border);
            border-radius: 10px;
            padding: 1.25rem;
            text-align: center;
            cursor: pointer;
            transition: border-color 0.2s;
            position: relative;
        }

            .upload-area:hover {
                border-color: var(--accent);
            }

            .upload-area input[type="file"] {
                position: absolute;
                inset: 0;
                opacity: 0;
                cursor: pointer;
                width: 100%;
                height: 100%;
                padding: 0;
                border: none;
                background: none;
            }

        .upload-text {
            color: var(--muted);
            font-size: 0.85rem;
        }

            .upload-text span {
                color: var(--accent);
                font-weight: 600;
            }

        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .btn-save {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: linear-gradient(135deg, var(--accent), #9b8aff);
            color: white;
            padding: 0.85rem 2rem;
            border-radius: 100px;
            border: none;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(124,106,255,0.3);
            transition: transform 0.2s;
        }

            .btn-save:hover {
                transform: translateY(-2px);
            }

        .btn-cancel {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
            padding: 0.85rem 2rem;
            border-radius: 100px;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-cancel:hover {
                border-color: var(--muted);
                color: var(--text);
            }

        @@media (max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 1rem;
                padding-top: 4rem;
            }

            .menu-toggle {
                display: block;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-logo">FN. Admin</div>
        <nav class="sidebar-menu">
            <a class="sidebar-item" href="/Admin/Dashboard"><i class="fas fa-th-large"></i> Dashboard</a>
            <a class="sidebar-item" href="/Admin/Create"><i class="fas fa-plus-circle"></i> Shto Projekt</a>
            <a class="sidebar-item active" href="/Admin/EditAbout"><i class="fas fa-user-edit"></i> Edito Profilin</a>
            <a class="sidebar-item" href="/" target="_blank"><i class="fas fa-eye"></i> Shiko Faqen</a>
        </nav>
        <div class="sidebar-bottom">
            <form method="post" asp-action="Logout" asp-controller="Admin">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-item"><i class="fas fa-sign-out-alt"></i> Dilni</button>
            </form>
        </div>
    </div>

    <main class="main">
        <div class="page-header">
            <a href="/Admin/Dashboard" class="back-btn"><i class="fas fa-arrow-left"></i> Kthehu</a>
            <h1 class="page-title">Edito Profilin</h1>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
        }

        <div class="form-card">
            <form method="post" asp-action="EditAbout" asp-controller="Admin" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="form-row">
                    <div class="form-group full" style="margin-bottom:1.25rem;">
                        <label>Foto Profili</label>
                        <div class="profile-preview">
                            @if (!string.IsNullOrEmpty(Model?.ProfileImagePath))
                            {
                                <img src="@Model.ProfileImagePath" class="profile-avatar" id="avatarPreview" alt="Profile" />
                            }
                            else
                            {
                                <div class="profile-avatar-placeholder" id="avatarPlaceholder">FN</div>
                            }
                            <div style="flex:1;">
                                <div class="upload-area">
                                    <input type="file" name="profileImage" accept="image/*" id="profileInput" />
                                    <div class="upload-text"><span>Ndrysho foton</span> e profilit</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Emri i Plotë</label>
                        <input asp-for="FullName" type="text" />
                    </div>
                    <div class="form-group">
                        <label>Titulli / Roli</label>
                        <input asp-for="Title" type="text" placeholder="p.sh. Front-End Developer" />
                    </div>
                    <div class="form-group full">
                        <label>Bio</label>
                        <textarea asp-for="Bio"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input asp-for="Email" type="email" />
                    </div>
                    <div class="form-group">
                        <label>GitHub URL</label>
                        <input asp-for="GitHubUrl" type="url" />
                    </div>
                    <div class="form-group full">
                        <label>LinkedIn URL</label>
                        <input asp-for="LinkedInUrl" type="url" placeholder="https://linkedin.com/in/..." />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-save"><i class="fas fa-save"></i> Ruaj Ndryshimet</button>
                    <a href="/Admin/Dashboard" class="btn-cancel"><i class="fas fa-times"></i> Anulo</a>
                </div>
            </form>
        </div>
    </main>

    <script>
        document.getElementById('menuToggle').addEventListener('click', () =>
            document.getElementById('sidebar').classList.toggle('open'));

        document.getElementById('profileInput').addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    const placeholder = document.getElementById('avatarPlaceholder');
                    if (placeholder) placeholder.style.display = 'none';
                    let img = document.getElementById('avatarPreview');
                    if (!img) {
                        img = document.createElement('img');
                        img.id = 'avatarPreview';
                        img.className = 'profile-avatar';
                        document.querySelector('.profile-preview').prepend(img);
                    }
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>